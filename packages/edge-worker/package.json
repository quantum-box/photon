{
  "name": "@quantum-box/photon-edge-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cloudflare Worker: authenticated Photon Engine proxy with a fail-closed Live relay",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev --config wrangler.jsonc --port 8787",
    "deploy": "wrangler deploy --config wrangler.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260505.1",
    "vitest": "^4.1.2",
    "wrangler": "^4.87.0"
  }
}
