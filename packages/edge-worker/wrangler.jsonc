{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "photon-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-05",
  "vars": {
    "PHOTON_CLOUD_ENGINE_BASE_URL": "http://127.0.0.1:3001"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PHOTON_SYNC_ROOMS",
        "class_name": "PhotonSyncRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PhotonSyncRoom"]
    }
  ]
}
