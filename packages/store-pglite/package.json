{
  "name": "@quantum-box/photon-store-pglite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PGlite durable storage adapter for the Photon engine",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
