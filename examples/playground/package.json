{
  "name": "@quantum-box/photon-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Dogfooding app for the Photon engine. Not a product \u2014 a regression surface.",
  "scripts": {
    "dev": "vite",
    "dev:cf-sync": "VITE_PHOTON_SYNC_WS_URL=ws://127.0.0.1:8787/ws vite",
    "build": "tsc -b && vite build",
    "type-check": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test-storybook": "vitest --config vitest.storybook.config.ts --project=storybook",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile-chrome",
    "test:e2e:ui": "playwright test --ui",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "pages:deploy": "npm run build && cd dist && wrangler pages deploy . --project-name photon --branch main --commit-dirty=true",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:android:init": "tauri android init",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "tauri:ios:init": "tauri ios init",
    "tauri:ios:dev": "tauri ios dev",
    "tauri:ios:build": "tauri ios build",
    "tauri:ios:build:sim": "tauri ios build --target aarch64-sim"
  },
  "dependencies": {
    "@blocknote/core": "^0.50.0",
    "@blocknote/react": "^0.50.0",
    "@blocknote/shadcn": "^0.50.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@electric-sql/pglite": "^0.4.5",
    "@quantum-box/photon-core": "*",
    "@quantum-box/photon-store-pglite": "*",
    "@quantum-box/photon-wasm": "*",
    "@radix-ui/themes": "^3.3.0",
    "@tanstack/react-router": "^1.168.10",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.23",
    "@tauri-apps/api": "^2.10.1",
    "@xyflow/react": "^12.10.2",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.2.2",
    "xlsx": "^0.18.5",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-vitest": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.6",
    "jsdom": "^29.0.1",
    "storybook": "^10.3.6",
    "vite": "^8.0.1",
    "vitest": "^4.1.2",
    "wrangler": "^4.87.0"
  }
}
