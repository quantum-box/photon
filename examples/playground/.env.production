VITE_PHOTON_DEPLOYMENT_MODE=cloud
VITE_PHOTON_API_BASE_URL=https://api.n1.tachy.one
VITE_PHOTON_SYNC_BACKEND=cloudflare-durable-object
VITE_PHOTON_SYNC_WS_URL=wss://photon-sync.quantum-box.workers.dev/ws
VITE_PHOTON_AUTH_ENABLED=true
VITE_PHOTON_AUTH_TRANSPORT=rest
VITE_PHOTON_AUTH_PASSWORD_PATH=/auth/v1beta/sign-in-with-password
# Legacy platform-token sign-in path retained for migration compatibility.
VITE_PHOTON_AUTH_REST_PATH=/auth/v1beta/sign-in-with-platform
# Switch to graphql after the target auth gateway exposes sign_in_with_platform there.
VITE_PHOTON_AUTH_GRAPHQL_PATH=/graphql
VITE_PHOTON_AUTH_GRAPHQL_MUTATION=sign_in_with_platform
# Override if the auth GraphQL response type exposes different field names.
# VITE_PHOTON_AUTH_GRAPHQL_SELECTION=token expires_at user { id email name }
# Provider and tenant/operator ids are environment-specific. Do not commit secrets.
VITE_PHOTON_AUTH_TENANT_ID=tn_01hjjn348rn3t49zz6hvmfq67p
# VITE_PHOTON_OPERATOR_ID=
# VITE_PHOTON_AUTH_PLATFORM_ID=
# VITE_PHOTON_AUTH_PROVIDER_ID=
