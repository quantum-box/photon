{
  "name": "@quantum-box/photon",
  "version": "0.3.0",
  "type": "module",
  "description": "Local-first sync engine: durable offline writes, instant UI, convergent reconciliation",
  "license": "MIT",
  "author": "Quantum Box",
  "homepage": "https://github.com/quantum-box/photon#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quantum-box/photon.git"
  },
  "bugs": {
    "url": "https://github.com/quantum-box/photon/issues"
  },
  "keywords": [
    "local-first",
    "sync",
    "offline",
    "crdt",
    "optimistic-ui",
    "pglite",
    "react"
  ],
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "packages/*",
    "examples/playground"
  ],
  "files": [
    "packages/core/dist",
    "packages/core/src",
    "packages/react/dist",
    "packages/react/src",
    "packages/store-pglite/dist",
    "packages/store-pglite/src",
    "packages/wasm/dist",
    "packages/wasm/src",
    "packages/edge-worker/dist",
    "packages/edge-worker/src",
    "crates/photon-engine/pkg",
    "!packages/*/src/**/*.test.ts",
    "README.md",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./packages/core/dist/index.d.ts",
      "default": "./packages/core/dist/index.js"
    },
    "./react": {
      "types": "./packages/react/dist/index.d.ts",
      "default": "./packages/react/dist/index.js"
    },
    "./rest": {
      "types": "./packages/core/dist/rest/index.d.ts",
      "default": "./packages/core/dist/rest/index.js"
    },
    "./store-pglite": {
      "types": "./packages/store-pglite/dist/index.d.ts",
      "default": "./packages/store-pglite/dist/index.js"
    },
    "./wasm": {
      "types": "./packages/wasm/dist/index.d.ts",
      "default": "./packages/wasm/dist/index.js"
    },
    "./worker": {
      "types": "./packages/edge-worker/dist/index.d.ts",
      "default": "./packages/edge-worker/dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run build:packages && npm run build --workspace @quantum-box/photon-playground",
    "build:packages": "npm run build --workspace @quantum-box/photon-core --workspace @quantum-box/photon-wasm --workspace @quantum-box/photon-store-pglite --workspace @quantum-box/photon-react --workspace @quantum-box/photon-edge-worker && node scripts/rewrite-internal-imports.mjs",
    "type-check": "npm run type-check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "prepare": "npm run engine:wasm && npm run build:packages",
    "smoke:exports": "node scripts/smoke-public-exports.mjs",
    "engine:wasm": "npx wasm-pack build crates/photon-engine --target web --out-dir pkg --no-default-features --features wasm",
    "server": "cargo run --bin photon-server",
    "server:engine": "cargo run --bin photon-engine-server",
    "server:live": "cargo run --bin photon-live-server",
    "server:engine:smoke": "node scripts/smoke-engine-api.mjs",
    "server:test": "cargo test --workspace",
    "mock:tachyon": "cargo run --bin mock-tachyon-api",
    "worker:dev": "npm run dev --workspace @quantum-box/photon-edge-worker",
    "worker:deploy": "npm run deploy --workspace @quantum-box/photon-edge-worker",
    "type-check:worker": "npm run type-check --workspace @quantum-box/photon-edge-worker",
    "dev": "npm run dev --workspace @quantum-box/photon-playground",
    "dev:cf-sync": "npm run dev:cf-sync --workspace @quantum-box/photon-playground",
    "preview": "npm run preview --workspace @quantum-box/photon-playground",
    "storybook": "npm run storybook --workspace @quantum-box/photon-playground",
    "build-storybook": "npm run build-storybook --workspace @quantum-box/photon-playground",
    "test-storybook": "npm run test-storybook --workspace @quantum-box/photon-playground",
    "test:e2e": "npm run test:e2e --workspace @quantum-box/photon-playground",
    "test:e2e:mobile": "npm run test:e2e:mobile --workspace @quantum-box/photon-playground",
    "test:e2e:ui": "npm run test:e2e:ui --workspace @quantum-box/photon-playground",
    "tauri": "npm run tauri --workspace @quantum-box/photon-playground",
    "tauri:dev": "npm run tauri:dev --workspace @quantum-box/photon-playground",
    "tauri:build": "npm run tauri:build --workspace @quantum-box/photon-playground",
    "tauri:android:init": "npm run tauri:android:init --workspace @quantum-box/photon-playground",
    "tauri:android:dev": "npm run tauri:android:dev --workspace @quantum-box/photon-playground",
    "tauri:android:build": "npm run tauri:android:build --workspace @quantum-box/photon-playground",
    "tauri:ios:init": "npm run tauri:ios:init --workspace @quantum-box/photon-playground",
    "tauri:ios:dev": "npm run tauri:ios:dev --workspace @quantum-box/photon-playground",
    "tauri:ios:build": "npm run tauri:ios:build --workspace @quantum-box/photon-playground",
    "tauri:ios:build:sim": "npm run tauri:ios:build:sim --workspace @quantum-box/photon-playground",
    "pages:build": "npm run build --workspace @quantum-box/photon-playground",
    "pages:deploy": "npm run pages:deploy --workspace @quantum-box/photon-playground"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.4.5"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0"
  }
}
