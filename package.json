{
  "name": "tachyon-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cf-sync": "VITE_PHOTON_SYNC_WS_URL=ws://127.0.0.1:8787/ws vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "type-check": "tsc -b --noEmit",
    "type-check:worker": "tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "VITE_PHOTON_SYNC_WS_URL=wss://photon-sync.quantum-box.workers.dev/ws tauri build",
    "tauri:android:init": "tauri android init",
    "tauri:android:dev": "VITE_PHOTON_SYNC_WS_URL=wss://photon-sync.quantum-box.workers.dev/ws tauri android dev",
    "tauri:android:build": "VITE_PHOTON_SYNC_WS_URL=wss://photon-sync.quantum-box.workers.dev/ws tauri android build",
    "tauri:ios:init": "tauri ios init",
    "tauri:ios:dev": "VITE_PHOTON_SYNC_WS_URL=wss://photon-sync.quantum-box.workers.dev/ws tauri ios dev",
    "tauri:ios:build": "VITE_PHOTON_SYNC_WS_URL=wss://photon-sync.quantum-box.workers.dev/ws tauri ios build",
    "pages:build": "VITE_PHOTON_SYNC_WS_URL=wss://photon-sync.quantum-box.workers.dev/ws npm run build",
    "pages:deploy": "npm run pages:build && cd dist && wrangler pages deploy . --project-name photon --branch main --commit-dirty=true",
    "worker:dev": "wrangler dev --config wrangler.jsonc --port 8787",
    "worker:deploy": "wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@radix-ui/themes": "^3.3.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-router": "^1.168.10",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.23",
    "@tauri-apps/api": "^2.10.1",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.2.2",
    "xlsx": "^0.18.5",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260505.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.2",
    "wrangler": "^4.87.0"
  }
}
